    "@sudobility/types": "^1.9.76",
    "@sudobility/design": "^1.1.66"
  },
  "devDependencies": {
    "@sudobility/design": "^1.1.66",
    "@eslint/js": "~10.0.1",
    "@react-native-segmented-control/segmented-control": "~2.5.7",
    "@sudobility/subscription-components-rn": "^1.0.7",
